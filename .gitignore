# The Pediatric Sentinel - .gitignore
# Excludes sensitive data, large files, and environment-specific files

# ============================================================================
# Virtual Environment
# ============================================================================
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ============================================================================
# Data Files (LARGE - do not commit)
# ============================================================================
# Raw NHANES data files (SAS .xpt files are large)
data/raw/*.xpt
data/raw/*.XPT

# Processed datasets (can be large CSV files)
data/processed/*.csv
data/processed/*.pkl
data/processed/*.parquet

# Metadata (can regenerate)
data/metadata/*.json
data/metadata/*.txt

# ============================================================================
# Model Files (LARGE - do not commit)
# ============================================================================
# Trained model checkpoints
models/checkpoints/*.pkl
models/checkpoints/*.joblib
models/checkpoints/*.h5

# Final trained models
models/final/*.pkl
models/final/*.joblib

# Model metadata (optional - can commit if small)
# models/metadata/*.json

# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff (if applicable):
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff (if applicable):
instance/
.webassets-cache

# Scrapy stuff (if applicable):
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# ============================================================================
# Jupyter Notebook
# ============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ============================================================================
# Environment Variables
# ============================================================================
.env
.env.local
.env.*.local
.venv
env/
venv/

# ============================================================================
# IDEs and Editors
# ============================================================================
# VSCode
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# Visual Studio
.vs/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Operating System Files
# ============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*

# ============================================================================
# Logs and Temporary Files
# ============================================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*.old

# ============================================================================
# Streamlit
# ============================================================================
.streamlit/secrets.toml
.streamlit/config.toml

# ============================================================================
# Project-Specific
# ============================================================================
# Experimental notebooks (optional)
notebooks/experiments/

# Temporary scripts
scripts/temp/
scripts/scratch/

# Downloaded datasets (if testing with different sources)
data/external/

# Archived files
archive/
*.zip
*.tar
*.tar.gz
*.rar

# ============================================================================
# Documentation (optional - can commit)
# ============================================================================
# Uncomment if you don't want to commit generated docs
# docs/_build/
# docs/_static/
# docs/_templates/

# ============================================================================
# Misc
# ============================================================================
.cache/
*.swp
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
